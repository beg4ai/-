{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dongshao:v1:maps.navigate",
  "title": "maps.navigate",
  "$ref": "#/$defs/input",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "place_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mode": {
          "type": "string",
          "enum": [
            "walking",
            "driving",
            "transit",
            "cycling"
          ]
        }
      },
      "required": [
        "place_id",
        "mode"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "action": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "open_navigation"
            },
            "provider": {
              "type": "string",
              "enum": [
                "amap",
                "apple_maps"
              ]
            },
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "fallback_uri": {
              "type": "string",
              "format": "uri"
            },
            "destination": {
              "type": "string"
            },
            "place_id": {
              "type": "string"
            },
            "coordinate_system": {
              "type": "string",
              "enum": [
                "wgs84",
                "gcj02"
              ]
            },
            "requires_confirmation": {
              "type": "boolean"
            },
            "opened": {
              "type": "boolean"
            },
            "mode": {
              "type": "string"
            },
            "execution": {
              "type": "string",
              "enum": [
                "proposal",
                "approved_not_opened",
                "opened"
              ]
            }
          },
          "required": [
            "type",
            "provider",
            "uri",
            "fallback_uri",
            "destination",
            "place_id",
            "coordinate_system",
            "requires_confirmation",
            "opened",
            "mode",
            "execution"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  }
}
